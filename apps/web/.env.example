# Copy to .env.local (git-ignored). Placeholders only.
# real = the .NET API (what `pnpm dev` uses); mock = Prism from `pnpm mock` (http://localhost:4010).
# `pnpm dev` / `pnpm dev:mock` set this for you; this file only matters when you run `pnpm dev:web` directly.
API_MODE=real
API_BASE_URL=http://localhost:5100/v1
API_MOCK_URL=http://localhost:4010
# PMTiles archive URL (must support HTTP Range). Empty until configured.
NEXT_PUBLIC_TILES_URL=
